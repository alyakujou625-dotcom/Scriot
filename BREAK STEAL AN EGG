-- ─── Key System Verification ─────────────────────────────────────────────────

local KEY_SYSTEM_PASSED = false
local KEY_FILE_NAME     = "KenHub_KeyAuth.json"
local CORRECT_KEY       = "KENHUBOFFICIAL"
local KEY_DISCORD_LINK  = "https://discord.gg/tDnTUSETu"

local function checkExistingKey()
    if not isfile or not readfile or not isfile(KEY_FILE_NAME) then return false end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(KEY_FILE_NAME)) end)
    if ok and data and data.Key == CORRECT_KEY and data.Timestamp then
        -- Check if 1 hour (3600 seconds) has elapsed
        if os.time() - data.Timestamp < 3600 then
            return true
        end
    end
    return false
end

local function saveKeySession()
    if writefile then
        pcall(function()
            writefile(KEY_FILE_NAME, HttpService:JSONEncode({
                Key = CORRECT_KEY,
                Timestamp = os.time()
            }))
        end)
    end
end

if checkExistingKey() then
    KEY_SYSTEM_PASSED = true
else
    -- Load WindUI just for the Key System window popup
    local windUISource
    pcall(function()
        if isfile and readfile and isfile("WindUI_Cache.lua") then
            windUISource = readfile("WindUI_Cache.lua")
        else
            windUISource = game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua")
        end
    end)

    if windUISource then
        local chunk = loadstring(windUISource)
        if chunk then
            local ok, wlib = pcall(chunk)
            if ok and type(wlib) == "table" then
                local keyWindow = wlib:CreateWindow({
                    Title       = "KenHub - Key Authentication",
                    Icon        = "rbxassetid://110165664140192",
                    Size        = UDim2.fromOffset(450, 260),
                    Transparent = true,
                    Theme       = "Dark",
                    Resizable   = false,
                })

                local keyTab = keyWindow:Tab({ Title = "Access Key", Icon = "key" })
                local keySec = keyTab:Section({ Title = "Enter Key to Proceed", Opened = true })

                local enteredKeyText = ""

                keySec:Paragraph({ Title = "Get Key from Discord", Desc = "Join our community discord to get your authorization key:\n" .. KEY_DISCORD_LINK })

                keySec:Input({
                    Title       = "Authorization Key",
                    Placeholder = "Enter Key Here...",
                    Callback    = function(v) enteredKeyText = v end,
                })

                keySec:Button({
                    Title = "Verify Key",
                    Callback = function()
                        if enteredKeyText == CORRECT_KEY then
                            saveKeySession()
                            KEY_SYSTEM_PASSED = true
                            wlib:Notify({ Title = "Success", Content = "Key verified! Loading script...", Duration = 3, Icon = "check" })
                            pcall(function() keyWindow:Destroy() end)
                        else
                            wlib:Notify({ Title = "Invalid Key", Content = "The key entered is incorrect.", Duration = 3, Icon = "x" })
                        end
                    end,
                })

                keySec:Button({
                    Title = "Copy Discord Link",
                    Callback = function()
                        if setclipboard then pcall(function() setclipboard(KEY_DISCORD_LINK) end) end
                        wlib:Notify({ Title = "Copied", Content = "Discord link copied to clipboard!", Duration = 2, Icon = "copy" })
                    end,
                })
            end
        end
    end

    -- Yield until user inputs the correct key
    while not KEY_SYSTEM_PASSED do
        task.wait(0.5)
    end
end

