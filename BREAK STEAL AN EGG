                windUI:Notify({ Title="Load Error", Content=tostring(err), Duration=3, Icon="x" })
            end
        end,
    })

    profileSec:Toggle({
        Title = "Auto Load Profile On Startup", Desc = "Automatically loads your active configuration when script runs",
        Value = autoLoadEnabled,
        Callback = function(v)
            autoLoadEnabled = v
            pcall(function()
