local function teleportToTreadmill()
    local plot = getPlot()
    if not plot then return false end
    local ghost  = plot:FindFirstChild("Ghost Treadmill")
    if not ghost then
        for _, desc in ipairs(plot:GetDescendants()) do
            if desc.Name:find("Treadmill") then ghost = desc; break end
        end
    end
    local hitbox   = ghost and (ghost:FindFirstChild("Hitbox") or ghost:FindFirstChildWhichIsA("BasePart"))
    if not hitbox then return false end
    local hrp      = getHRP()
    local humanoid = getHumanoid()
    if hrp and humanoid then
        hrp.Anchored = false
        hrp.CFrame   = hitbox.CFrame + Vector3.new(0, 1.5, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.2)
        humanoid:Move(Vector3.new(0, 0, -1), true)
        task.wait(0.35)
        return true
    end
    return false
end

