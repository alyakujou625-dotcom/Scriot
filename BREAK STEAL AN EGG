                        currentTracking[plr.Character] = {Type = "Player", Color = Color3.fromRGB(71, 85, 105)}
                    end
                end
            end

            for target, hl in pairs(activeHighlights) do
                if not currentTracking[target] or not target.Parent then
                    if hl then hl:Destroy() end
                    activeHighlights[target] = nil
                end
