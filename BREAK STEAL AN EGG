                for _, pickup in ipairs(CollectionService:GetTagged("AnimalPickup")) do
                    if pickup and pickup.Parent then
                        currentTracking[pickup] = {Type = "Pickup", Color = Color3.fromRGB(148, 163, 184)}
                    end
