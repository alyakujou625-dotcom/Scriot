        local list = {}
        if listfiles and isfolder and isfolder("KenHub_BreakAndStealAnEgg/configs") then
            pcall(function()
                for _, path in ipairs(listfiles("KenHub_BreakAndStealAnEgg/configs")) do
                    local name = path:match("([^\\/]+)%.json$")
                    if name and name ~= "autoload" then table.insert(list, name) end
                end
            end)
        end
        table.sort(list)
        if #list == 0 then table.insert(list, "default") end
        return list
    end

    local function saveProfile(name)
        if not writefile then return false, "writefile not supported" end
        if not name or name == "" or name == "autoload" then return false, "Invalid profile name" end
        local snapshot = {}
        for k, v in pairs(state) do snapshot[k] = v end
        local ok, encoded = pcall(function() return HttpService:JSONEncode(snapshot) end)
        if not ok then return false, "JSON encoding error" end
        local wok, werr = pcall(function() writefile("KenHub_BreakAndStealAnEgg/configs/"..name..".json", encoded) end)
        if not wok then return false, tostring(werr) end
        return true
    end

    local function loadProfile(name)
        if not readfile or not isfile then return false, "readfile not supported" end
        if not name or name == "" or name == "autoload" then return false, "Invalid profile name" end
        local path = "KenHub_BreakAndStealAnEgg/configs/"..name..".json"
        if not isfile(path) then return false, "Profile file not found" end
        local rok, content = pcall(function() return readfile(path) end)
        if not rok or not content then return false, "Failed to read profile" end
        local dok, decoded = pcall(function() return HttpService:JSONDecode(content) end)
        if not dok or type(decoded) ~= "table" then return false, "Corrupted profile data" end
        for k, v in pairs(decoded) do state[k] = v end
        return true
    end

    local autoLoadEnabled = false
    local activeProfile   = "default"

    pcall(function()
        if readfile and isfile and isfile("KenHub_BreakAndStealAnEgg/configs/autoload.json") then
            local data = HttpService:JSONDecode(readfile("KenHub_BreakAndStealAnEgg/configs/autoload.json"))
