-- ─── Raycast / Position Helpers ──────────────────────────────────────────────

local function getGroundY(position, refPart)
    local params   = RaycastParams.new()
    local excluded = {}

    for _, egg in ipairs(CollectionService:GetTagged("BreakableEgg")) do
        table.insert(excluded, egg)
        if egg.Parent and egg.Parent:IsA("Model") then table.insert(excluded, egg.Parent) end
    end
    if localPlayer.Character then table.insert(excluded, localPlayer.Character) end
    local gp = workspace:FindFirstChild("KenHub_GlobalPlatform")
    local np = workspace:FindFirstChild("KenHub_NinjaPlatform")
    if gp then table.insert(excluded, gp) end
    if np then table.insert(excluded, np) end

    params.FilterDescendantsInstances = excluded
    params.FilterType = Enum.RaycastFilterType.Exclude

    local startY = (position and position.Y or 3) + 2
    if refPart and refPart:IsA("BasePart") then startY = refPart.Position.Y + 2 end

    local result = workspace:Raycast(Vector3.new(position.X, startY, position.Z), Vector3.new(0, -50, 0), params)
    if result then return result.Position.Y end
    return position and position.Y > 5 and position.Y - 2 or 0.5
end

local function getUnderPosition(position, refPart, depth)
    local groundY      = getGroundY(position, refPart)
    local clampedDepth = math.clamp(depth or 2.8, 1.5, 4)
    return Vector3.new(position.X, groundY - clampedDepth, position.Z), groundY
end

-- ─── Rarity System ───────────────────────────────────────────────────────────

local rarityMap = {}

local rarityRank = {
    common=1, uncommon=2, rare=3, epic=4, legendary=5,
    mythic=6, divine=7, cosmic=8, secret=9, celestial=10, inferno=11,
}

local rarityFilterThreshold = {
    ["Inferno and Above"]=11, ["Celestial and Above"]=10, ["Secret and Above"]=9,
    ["Cosmic and Above"]=8,   ["Divine and Above"]=7,     ["Mythic and Above"]=6,
    ["Legendary and Above"]=5,["Epic and Above"]=4,       ["Rare and Above"]=3,
    ["Uncommon and Above"]=2, ["Any Rarity"]=1,
}

local function parseAnimalLabel(label)
    if not label then return "Unknown", 0, "Common" end
    local weightStr = label:match("%[([%d%.,]+)%s*[Kk][Gg]%]")
    local weightKg  = weightStr and tonumber((weightStr:gsub(",", ""))) or 0
    local name      = label:gsub("<[^>]+>", ""):gsub("%[[^%]]+%]%s*", ""):match("^%s*(.-)%s*$") or "Unknown"
    return name, weightKg, rarityMap[name:lower():gsub("%s+", "")] or "Common"
end

local function meetsRarityFilter(label, _, filter)
    if not filter or filter == "Any Rarity" then return true end
    local _, _, rarity = parseAnimalLabel(label)
    return (rarityRank[rarity:lower()] or 1) >= (rarityFilterThreshold[filter] or 1)
end

-- ─── Tab Builder Helper ──────────────────────────────────────────────────────

local function buildTab(_, name, buildFn)
    local t0 = os.clock()
    local ok, err = xpcall(buildFn, function(e)
        return debug and debug.traceback and debug.traceback(tostring(e), 2) or tostring(e)
    end)
    if not ok then
        warn(("[KenHub %s Error]: %s"):format(name, tostring(err)))
    else
        print(("[KenHub] %s tab built in %.2fs"):format(name, os.clock() - t0))
    end
    task.wait()
end

