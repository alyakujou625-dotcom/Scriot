end)

local function unlockCharacter()
    pcall(function() RunService:UnbindFromRenderStep("TreadmillFaceLock") end)
    local hrp      = getHRP()
    local humanoid = getHumanoid()
    if hrp      then hrp.Anchored = false end
    if humanoid then
        humanoid.AutoRotate = true
        humanoid.Jump = true
        humanoid:ChangeState("Jumping")
    end
    task.wait(0.2)
end

local function isTreadmillActive()
    local plot = getPlot()
    if not plot then return false end
    local ghost   = plot:FindFirstChild("Ghost Treadmill")
    local hitbox  = ghost and (ghost:FindFirstChild("Hitbox") or ghost:FindFirstChildWhichIsA("BasePart"))
    local hrp     = getHRP()
    if hitbox and hrp and (hrp.Position - hitbox.Position).Magnitude > 8 then return false end
    if treadmillController and treadmillController.IsActive then
        local ok, active = pcall(function() return treadmillController.IsActive() end)
        return ok and active or false
    end
    return false
end

