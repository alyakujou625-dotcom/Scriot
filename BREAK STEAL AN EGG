-- ─── Ninja Snatch Executor ───────────────────────────────────────────────────

local isSnatching = false

local function executeNinjaSnatch(targetPos, prompt, animalName)
    if isSnatching then return end
    isSnatching = true
    unlockCharacter()

    local hrp      = getHRP()
    local humanoid = getHumanoid()
    if not hrp or not humanoid then isSnatching = false; return end

    if localPlayer.Character then
        for _, part in ipairs(localPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then pcall(function() part.CanCollide = false end) end
        end
    end

    ensureGlobalPlatform()
    local underPos = getUnderPosition(targetPos, nil, state.UnderDepth or 2.8)

    hrp.Anchored = false
    hrp.CFrame   = CFrame.new(underPos)
    hrp.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.12)

    if prompt and prompt.Parent then
        pcall(function()
            prompt.HoldDuration          = 0
            prompt.MaxActivationDistance = 9999
            prompt.RequiresLineOfSight   = false
        end)
    end

    local snatchStart = os.clock()
    local snatched    = false

    windUI:Notify({ Title="Ninja Snatch!", Content=("Snatching %s (Instant E)..."):format(animalName or "Animal"), Duration=3, Icon="target" })

    while state.NinjaSteal and os.clock() - snatchStart < 4 do
        if hrp and (hrp.Position - underPos).Magnitude > 4 then
            hrp.CFrame = CFrame.new(underPos)
            hrp.AssemblyLinearVelocity = Vector3.zero
        end

        local carrying   = localPlayer:GetAttribute("Carrying")
        local carryCount = localPlayer:GetAttribute("CarryCount")

        if carrying ~= nil or (carryCount and carryCount > 0) then
            snatched = true; break
        elseif prompt and prompt.Parent then
            pcall(function()
                prompt.HoldDuration          = 0
                prompt.MaxActivationDistance = 9999
                prompt.RequiresLineOfSight   = false
            end)
            if fireproximityprompt then pcall(function() fireproximityprompt(prompt, 0) end) end
            pcall(function() prompt:InputHoldBegin(); task.wait(); prompt:InputHoldEnd() end)
            task.wait(0.05)
        else
            task.wait(0.08)
            if localPlayer:GetAttribute("Carrying") ~= nil then snatched = true end
            break
        end
    end

    destroyNinjaPlatform()

    if localPlayer.Character then
        for _, part in ipairs(localPlayer.Character:GetDescendants()) do
            local p = part
            if p:IsA("BasePart") and not p:IsA("Terrain") then
                pcall(function() p.CanCollide = true end)
            end
        end
    end

    if snatched or localPlayer:GetAttribute("Carrying") ~= nil then
        windUI:Notify({ Title="Snatch Success!", Content=("Secured %s! Banking at base..."):format(animalName or "Animal"), Duration=3, Icon="sparkles" })
        task.wait(0.05)
        teleportToBase()
        task.wait(0.3)
        local bankWait = os.clock()
        while localPlayer:GetAttribute("Carrying") ~= nil and os.clock() - bankWait < 4 do
            task.wait(0.15)
        end
    else
        windUI:Notify({ Title="Snatch Missed", Content="Prompt expired or taken. Returning...", Duration=2, Icon="x" })
    end

    if hrp then hrp.Anchored = false end

    if state.NinjaStealthRun and not state.AutoBreakUnder then
        unequipTools(); task.wait(0.1); teleportToTreadmill()
    end

    isSnatching = false
end

-- ─── Main Loops ──────────────────────────────────────────────────────────────

task.spawn(function()
    while true do
        if state.NinjaSteal and not isSnatching and not localPlayer:GetAttribute("Carrying") then
            for _, anchor in ipairs(workspace:GetChildren()) do
                if anchor.Name == "PromptAnchor" then
                    local prompt = anchor:FindFirstChild("StealPrompt") or anchor:FindFirstChild("HatchPrompt")
                    if prompt and prompt:IsA("ProximityPrompt") and prompt.Enabled then
                        local objectText = prompt.ObjectText or "Animal"
                        if meetsRarityFilter(objectText, "", state.TargetRarity) then
                            executeNinjaSnatch(anchor.Position, prompt, objectText); break
                        end
                    end
                end
            end

            if not isSnatching then
                for _, pickup in ipairs(CollectionService:GetTagged("AnimalPickup")) do
                    if pickup:IsA("Model") and pickup.Parent then
                        local rarity = pickup:GetAttribute("Rarity") or ""
                        local weight = pickup:GetAttribute("WeightBracket") or ""
                        if meetsRarityFilter(rarity.." "..pickup.Name, weight, state.TargetRarity) then
                            local part = pickup.PrimaryPart or pickup:FindFirstChildWhichIsA("BasePart")
                            if part then
                                executeNinjaSnatch(part.Position, pickup:FindFirstChildWhichIsA("ProximityPrompt", true), pickup.Name)
                                break
                            end
                        end
                    end
                end
            end

            if state.NinjaStealthRun and not isSnatching and not state.AutoBreakUnder then
                if not isTreadmillActive() then
                    local plot = getPlot()
                    if plot then
                        local ghost  = plot:FindFirstChild("Ghost Treadmill")
                        local hitbox = ghost and (ghost:FindFirstChild("Hitbox") or ghost:FindFirstChildWhichIsA("BasePart"))
                        local hrp    = getHRP()
                        if hitbox and hrp and (hrp.Position - hitbox.Position).Magnitude > 8 then
                            unequipTools(); teleportToTreadmill()
                        end
                    end
                end
            end
        end
        task.wait(0.3)
    end
end)

-- ─── Advanced Tween Auto-Farm Loop (Under-to-Up & Safe Anti-Void) ─────────────
local currentEgg      = nil
local swingController = nil
local activeTween     = nil

task.spawn(function()
    local eggHitRequest = ReplicatedStorage:FindFirstChild("EggHitRequest")
    while true do
        if state.AutoBreakUnder or state.AutoBreakAura then
            local hrp = getHRP()
            if hrp and not isSnatching then
                local eggValid = currentEgg and currentEgg.Parent
                    and currentEgg:IsA("BasePart")
                    and not currentEgg:GetAttribute("Broken")
                    and not currentEgg:GetAttribute("Hatching")
                    and not currentEgg:GetAttribute("Despawning")
                    and (currentEgg:GetAttribute("Health") == nil or currentEgg:GetAttribute("Health") > 0)

                if not eggValid then
                    if activeTween then activeTween:Cancel(); activeTween = nil end
                    if currentEgg and hrp then hrp.Anchored = false end
                    currentEgg = nil
                    destroyNinjaPlatform()

                    local bestEgg, bestDist = nil, 999999

                    for _, egg in ipairs(CollectionService:GetTagged("BreakableEgg")) do
                        if egg:IsA("BasePart")
                            and not egg:GetAttribute("Broken")
                            and not egg:GetAttribute("Hatching")
                            and not egg:GetAttribute("Despawning") then
                            local eggType = egg:GetAttribute("EggType") or ""
                            local weight  = egg:GetAttribute("WeightBracket") or "Normal"
                            if weight == "" then weight = "Normal" end

                            local typeOk   = state.TargetEggType == "All Eggs" or eggType:find(state.TargetEggType)
                            local weightOk = state.TargetWeight  == "Any"      or weight:upper() == state.TargetWeight:upper()

                            if typeOk and weightOk then
                                local dist = (egg.Position - hrp.Position).Magnitude
                                if state.AutoBreakAura and not state.AutoBreakUnder then
                                    if dist <= 12 and dist < bestDist then bestDist = dist; bestEgg = egg end
                                elseif dist < bestDist then
                                    bestDist = dist; bestEgg = egg
                                end
                            end
                        end
                    end

                    if bestEgg then
                        currentEgg = bestEgg
                        if state.AutoBreakUnder then
                            unlockCharacter()
                            ensureGlobalPlatform()
                            local targetUnderPos = getUnderPosition(bestEgg.Position, bestEgg, state.UnderFarmDepth or 2.8)
                            
                            if localPlayer.Character then
                                for _, part in ipairs(localPlayer.Character:GetDescendants()) do
                                    if part:IsA("BasePart") then part.CanCollide = false end
                                end
                            end

                            hrp.Anchored = false
                            
                            -- Smooth Under-to-Up Tween Transition with Velocity Safe-Guard
                            if activeTween then activeTween:Cancel() end
                            local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                            activeTween = TweenService:Create(hrp, tweenInfo, { CFrame = CFrame.new(targetUnderPos) })
                            activeTween:Play()
                            activeTween.Completed:Wait()
                            hrp.AssemblyLinearVelocity = Vector3.zero
                        end
                    elseif state.AutoTreadmill and not isSnatching then
                        if hrp then hrp.Anchored = false end
                        if not isTreadmillActive() then teleportToTreadmill() end
                    end
                end

                if currentEgg and currentEgg.Parent then
                    if state.AutoEquipPickaxe then equipPickaxe() end

                    if state.AutoBreakUnder then
                        local trackPos = getUnderPosition(currentEgg.Position, currentEgg, state.UnderFarmDepth or 2.8)
                        if (hrp.Position - trackPos).Magnitude > 3 and not (activeTween and activeTween.PlaybackState == Enum.PlaybackState.Playing) then
                            if activeTween then activeTween:Cancel() end
                            activeTween = TweenService:Create(hrp, TweenInfo.new(0.2, Enum.EasingStyle.Linear), { CFrame = CFrame.new(trackPos) })
                            activeTween:Play()
                        end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        if hrp.Anchored then hrp.Anchored = false end
                    end

                    if swingController and swingController.Swing then
                        pcall(function() swingController.Swing(currentEgg) end)
                    end

                    if eggHitRequest and eggHitRequest:IsA("RemoteEvent") then
                        pcall(function() eggHitRequest:FireServer(currentEgg) end)
                    end
                end
            end
        elseif currentEgg then
            if activeTween then activeTween:Cancel(); activeTween = nil end
            if localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart") then
                localPlayer.Character.HumanoidRootPart.Anchored = false
            end
            currentEgg = nil
        end
        task.wait(0.08)
    end
end)

