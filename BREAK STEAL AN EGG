local function createMobileToggle(window)
    local guiParent
    pcall(function()
        guiParent = gethui and gethui() or CoreGui:FindFirstChild("RobloxGui") or CoreGui
    end)
    if not guiParent then guiParent = localPlayer:WaitForChild("PlayerGui") end

    local mobileGui = Instance.new("ScreenGui")
    mobileGui.Name            = "KenHub_MobileToggle"
    mobileGui.ResetOnSpawn    = false
    mobileGui.DisplayOrder    = 999999
    mobileGui.IgnoreGuiInset  = true
    mobileGui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling
    mobileGui.Enabled         = false
    mobileGui.Parent          = guiParent

    local btn = Instance.new("ImageButton")
    btn.Name                = "KenToggleBtn"
    btn.Size                = UDim2.new(0, 56, 0, 56)
    btn.Position            = UDim2.new(0.35, 0, 0.15, 0)
    btn.BackgroundColor3    = Color3.fromHex("#1E293B")
    btn.BackgroundTransparency = 0.2
    btn.Image               = "rbxassetid://110165664140192"
    btn.ScaleType           = Enum.ScaleType.Fit
    btn.AutoButtonColor     = false
    btn.ZIndex              = 99999
    btn.Parent              = mobileGui

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(1, 0)
    btnCorner.Parent = btn

    local btnStroke = Instance.new("UIStroke")
    btnStroke.Thickness        = 2.5
    btnStroke.Color            = Color3.fromHex("#64748B")
    btnStroke.ApplyStrokeMode  = Enum.ApplyStrokeMode.Border
    btnStroke.Parent           = btn

    local isDragging, hasDragged = false, false
    local tapStartTime = 0
    local dragStartPos, dragStartInput

    local function handleDrag(input)
        local delta    = input.Position - dragStartInput
        local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
        btn.Position   = UDim2.new(0,
            math.clamp(dragStartPos.X.Offset + delta.X, 5, viewport.X - 61),
            0,
            math.clamp(dragStartPos.Y.Offset + delta.Y, 5, viewport.Y - 61)
        )
    end

    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        isDragging     = true
        hasDragged     = false
        dragStartPos   = btn.Position
        dragStartInput = input.Position
        tapStartTime   = tick()
        TweenService:Create(btn,       TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = UDim2.new(0, 50, 0, 50) }):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.12), { Color = Color3.fromHex("#94A3B8"), Thickness = 3 }):Play()
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then isDragging = false end
        end)
    end)

    btn.InputChanged:Connect(function(input)
        if not isDragging then return end
        if input.UserInputType ~= Enum.UserInputType.MouseMovement
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        if (input.Position - dragStartInput).Magnitude > 6 then hasDragged = true end
        if hasDragged then handleDrag(input) end
    end)

    btn.InputEnded:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        isDragging = false
        TweenService:Create(btn,       TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Size = UDim2.new(0, 56, 0, 56) }):Play()
        TweenService:Create(btnStroke, TweenInfo.new(0.15), { Color = Color3.fromHex("#64748B"), Thickness = 2.5 }):Play()
        local tapDuration = tick() - tapStartTime
        local moved       = (input.Position - (dragStartInput or input.Position)).Magnitude
        if not hasDragged and moved < 10 and tapDuration < 0.35 then
            pcall(function()
                if window.Closed then window:Open() else window:Close() end
            end)
        end
    end)

    btn.MouseEnter:Connect(function()
        TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = Color3.fromHex("#CBD5E1"), Thickness = 3.5 }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btnStroke, TweenInfo.new(0.2), { Color = Color3.fromHex("#64748B"), Thickness = 2.5 }):Play()
    end)

    if _G.KenHubConnections then
        table.insert(_G.KenHubConnections, {
            Disconnect = function() pcall(function() mobileGui:Destroy() end) end,
        })
    end
    return mobileGui
end

