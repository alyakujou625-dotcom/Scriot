    if existing then return existing end

    local folder = Instance.new("Folder")
    folder.Name   = "KenHub_GlobalPlatform"
    folder.Parent = workspace

    for i, cframe in ipairs({ CFrame.new(-700, -6, 0), CFrame.new(-2200, -6, 0) }) do
