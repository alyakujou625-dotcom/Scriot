local function getHRP()
    local char = localPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
    local char = localPlayer.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function getPlot()
    local plots = workspace:FindFirstChild("Plots")
    if not plots then return nil end
    for _, plot in ipairs(plots:GetChildren()) do
        if plot:GetAttribute("OwnerUserId") == localPlayer.UserId then return plot end
    end
    return nil
end

local function teleportToBase()
    local plot = getPlot()
    if not plot then
        windUI:Notify({ Title = "Plot Not Found", Content = "Could not locate your base plot.", Duration = 3, Icon = "alert-triangle" })
        return false
    end
    local anchor = plot:FindFirstChild("Hitbox") or plot:FindFirstChild("SpawnPoint")
    if not anchor then return false end
    local hrp = getHRP()
    if hrp then
        hrp.CFrame = anchor.CFrame + Vector3.new(0, 3.5, 0)
        hrp.AssemblyLinearVelocity = Vector3.zero
        return true
    end
    return false
end

